# ==========================================
# SHOPIFY CONFIGURATION
# ==========================================
# Your myshopify.com domain (e.g. ethnoirindia.myshopify.com)
SHOPIFY_SHOP=ethnoirindia.myshopify.com

# Shopify GraphQL API Version (e.g. 2026-07)
SHOPIFY_API_VERSION=2026-07

# Shopify Custom App / Partner App Credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ==========================================
# SHIPROCKET CONFIGURATION
# ==========================================
SHIPROCKET_API_BASE=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Shiprocket Pickup Location Nickname (as saved in your Shiprocket panel -> Settings -> Pickup Address)
SHIPROCKET_PICKUP_LOCATION_NAME=Primary Warehouse

# ==========================================
# APPLICATION & DATABASE CONFIGURATION
# ==========================================
# For zero-config local development, SQLite is used:
DATABASE_URL="file:./dev.db"

# For production PostgreSQL, uncomment and set your connection string:
# DATABASE_URL="postgresql://username:password@localhost:5432/return_refund_db?schema=public"

# Secure random secret for signing sessions and JWTs
SESSION_SECRET=change-this-to-a-super-secret-hex-key-in-production

# Return policy window in days (Order delivery date to return request)
RETURN_WINDOW_DAYS=7

# Maximum photo upload size in MB per file
MAX_UPLOAD_SIZE_MB=5

# Public URL of this application (used for webhooks and email links)
# For local development with webhooks, use your Cloudflare/ngrok tunnel URL
APP_URL=http://localhost:3000

# Port for the backend server
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ==========================================
# SUPABASE CONFIGURATION (Admin Authentication & RLS)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

